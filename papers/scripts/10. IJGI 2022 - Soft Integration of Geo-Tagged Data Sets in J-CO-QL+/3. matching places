//6
FILTER 
	CASES
		WHERE	
					WITH .f.fbName, .g.gName
				AND	
					KNOWN FUZZY SETS SameLocation   
			GENERATE	
				CHECK FOR 
					FUZZY SET SimilarName USING Similar(.f.fbName, .g.gName), 
					FUZZY SET MatchingPlaces USING WeightedAggregationBeta(MEMBERSHIP_TO (SimilarName), MEMBERSHIP_TO (SameLocation), 0.60)
				ALPHACUT 0.8 ON MatchingPlaces
				BUILD	{
					.f: .f, 
					.g: .g, 
					.rank: MEMBERSHIP_TO (MatchingPlaces)	}
				DEFUZZIFY;

//7
SAVE AS RelevantPairs@ijgiDb;
