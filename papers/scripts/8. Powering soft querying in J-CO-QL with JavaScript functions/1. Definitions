//1
CREATE JAVASCRIPT FUNCTION GeoKmDistance
	PARAMETERS
		lat1 TYPE Float,
		lon1 TYPE Float,
		lat2 TYPE Float,
		lon2 TYPE Float
	PRECONDITION
			lat1 >= -90
		AND	
			lat1 <= +90
		AND	
			lat2 >= -90
		AND	
			lat2 <= +90
		AND	
			lon1 >= -180
		AND	
			lon1 <= +180
		AND	
			lon2 >= -180
		AND	
			lon2 <= +180 
	BODY
	{
var R = 6371;var dLat = (lat2-lat1) * (Math.PI/180); 
var dLon = (lon2-lon1) * (Math.PI/180); 
var a = Math.sin(dLat/2) * Math.sin(dLat/2) +
Math.cos(lat1 * (Math.PI/180)) * 
Math.cos(lat2 * (Math.PI/180)) * 
Math.sin(dLon/2) * Math.sin(dLon/2) ; 
var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a)); 
var d = R * c;return d;
}
	END BODY;

//2
CREATE FUZZY OPERATOR Close
	PARAMETERS
		lat1 TYPE Float,
		lon1 TYPE Float,
		lat2 TYPE Float,
		lon2 TYPE Float
	EVALUATE GeoKmDistance(lat1, lon1, lat2, lon2)
	POLYLINE
		[	(0.0, 0.00),
			(0.5, 0.00),
			(0.6, 1.00),
			(1.0, 1.00),
			(3.0, 0.90),
			(6.0, 0.30),
			(10.0, 0.10),
			(15.0, 0.00),
			(20.0, 0.00)	];
