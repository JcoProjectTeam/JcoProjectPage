CREATE FUZZY OPERATOR covidAlertFO
PARAMETERS
population TYPE INTEGER,
TYPE INTEGER
PRECONDITION population > 0 AND
cases > 0
EVALUATE 1000 * 1000 * cases / population
POLYLINE
[ ( 0, 0.00), ( 30, 0.00), ( 100, 0.01),
( 200, 0.15), ( 750, 0.50), (1500, 0.80),
(2500, 0.90), (4000, 1.00) ];

USE DB softIntelligenceDb
ON SERVER jcods 'http://127.0.0.1:17017';

GET COLLECTION euMostRecentCovidData@softIntelligenceDb;

FILTER
CASE WHERE WITH .population, .cases
GENERATE
CHECK FOR FUZZY SET covidAlert
USING covidAlertFO (.population, .cases)
ALPHACUT ##alphaCutThreshold## ON covidAlert
BUILD {
.capital: .capital,
.cases: .cases,
.country: .country,
.indicator: .indicator,
.countryCode: .countryCode,
.countryCodeIsoAlpha2 : .countryCodeIsoAlpha2,
.population: .population,
.yearWeek: .yearWeek,
.casesPerMillion : TO INT (1000*1000 *.cases/.population),
.covidRisk: : MEMBERSHIP_TO (covidAlert)
}
DEFUZZIFY;

SAVE AS euCountryCovidRisk@softIntelligenceDb;
















