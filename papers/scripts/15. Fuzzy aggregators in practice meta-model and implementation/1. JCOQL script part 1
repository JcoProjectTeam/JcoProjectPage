CREATE FUZZY OPERATOR fuzzifyEvaluation
PARAMETERS eval TYPE INTEGER
PRECONDITION eval IN RANGE [1,10]
EVALUATE (eval-1) / 9;

CREATE FUZZY AGGREGATOR owa
PARAMETERS M TYPE ARRAY ASC
FOR ALL X IN M
LOCALLY (POS^2 -(POS-1) ^2) / (COUNT (M) ^2) AS W
AGGREGATE x * w AS av
EVALUATE av;

CREATE FUZZY AGGREGATOR weigher
PARAMETERS
M TYPE ARRAY,
weights TYPE ARRAY
PRECONDITION COUNT (M) = COUNT (weights)
FOR ALL X IN M
LOCALLY x * weights[POS] AS wi
AGGREGATE wi AS av
AGGREGATE weights [POS] AS aw
EVALUATE av / aw;


















