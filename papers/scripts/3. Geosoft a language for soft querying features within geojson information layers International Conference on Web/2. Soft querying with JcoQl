//3.
USE DB NUTS_Info
    ON SERVER MongoDB 'http://127.0.0.1:27017';

//4.
GET COLLECTION NUTSCollection@NUTS_Info;

//5.
FILTER 
	CASES
		WHERE	
				WITH .Pop2017, .Pop2018, .GDP2017, .GDP2018 
			GENERATE	
				CHECK FOR 
					FUZZY SET Decreasing_Population USING Has_Decreasing_Population(.Pop2017, .Pop2018), 
					FUZZY SET Increasing_GDP USING Has_Increasing_GDP(.GDP2017, .GDP2018), 
					FUZZY SET Wanted USING  Decreasing_Population AND Increasing_GDP 
				ALPHACUT 0.8 ON Wanted
		DROP OTHERS;

//6.
FILTER 
	CASES
		WHERE	
				KNOWN FUZZY SETS Wanted  
			GENERATE	
				BUILD	{
					.NUTSName: .NUTSName, 
					.NUTSCode: .NUTSCode, 
					.NUTSLevel: .NUTSLevel, 
					.CountryCode: .CountryCode, 
					.rank: MEMBERSHIP_TO (Wanted)	}
				DROPPING ALL FUZZY SETS 
		DROP OTHERS;

//7.
SAVE AS DetectedNUTS@NUTS_Info;