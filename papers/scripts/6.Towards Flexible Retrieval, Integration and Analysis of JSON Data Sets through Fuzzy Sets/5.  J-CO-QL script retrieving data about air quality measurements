//20
GET COLLECTION FROM WEB "https :// www.dati.lombardia.it/resource/nicp -bhqi.json?$limit =1000000&
$where=data >= ’2021-03-15’ AND data < ’2021-03-23’
AND (stato=’VV’ OR stato=’VA ’)";

//21
EXPAND
	UNPACK
			WITH ARRAY .data
		ARRAY .data
		TO .sensorData
	DROP OTHERS;

//22
FILTER 
	CASES
		WHERE	
				WITH .sensorData.item.idsensore 
			GENERATE	
				BUILD	{
					.sensorId: .sensorData.item.idsensore, 
					.dateTime: .sensorData.item.data, 
					.value: TO_FLOAT(.sensorData.item.valore)	}
		DROP OTHERS;

//23
SAVE AS AirQualityMeasures;
