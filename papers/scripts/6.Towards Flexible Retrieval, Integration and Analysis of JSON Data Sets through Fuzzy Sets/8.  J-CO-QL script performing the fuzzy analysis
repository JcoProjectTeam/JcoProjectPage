//32
FILTER 
	CASES
		WHERE	
				WITH .NOmeasure, .GRmeasure, .RPmeasure 
			GENERATE	
				CHECK FOR 
					FUZZY SET HighPollution USING Has_High_Pollution(.NOmeasure), 
					FUZZY SET LowRadiation USING Has_Low_Radiation(.GRmeasure), 
					FUZZY SET PersistentRain USING Has_Persistent_Rain(.RPmeasure), 
					FUZZY SET Wanted USING  HighPollution AND  LowRadiation OR PersistentRain  
				ALPHACUT 0.75 ON Wanted
		DROP OTHERS;

//33
FILTER 
	CASES
		WHERE	
				KNOWN FUZZY SETS Wanted  
			GENERATE	
				BUILD	{
					.stationName: .NOstatoinName, 
					.dateTime: .dateTime, 
					.rank: MEMBERSHIP_TO (Wanted)	}
				DROPPING ALL FUZZY SETS 
		DROP OTHERS;

//34
SAVE AS DetectedEvents@INFORMATION_2021;
